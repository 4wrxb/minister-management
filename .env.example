# Flask Configuration
FLASK_ENV=production
SECRET_KEY=your-secret-key-here-change-this

# Admin Credentials
# ⚠️ SECURITY: The application falls back to admin123 / minister123 if these are unset.
# Anyone with the admin password can edit/delete every player and publish schedules.
# CHANGE THESE before any non-trivial deployment (anything beyond local development).
ADMIN_PASSWORD=your-admin-password-here
MINISTER_PASSWORD=your-minister-password-here

# Database
# Docker Compose: /app/data/minister.db (default, volume-mounted)
# Bare metal dev: ./data/minister.db (relative to backend/)
# Cloud Run:      /data/minister.db (GCS FUSE mount)
DATABASE_PATH=/app/data/minister.db

# WOS API salt (public client-side constant from wos-giftcode.centurygame.com;
# override only if the upstream value rotates). See backend/app.py for context.
# WOS_API_SECRET=

# Server
PORT=8080

# --- Reverse-proxy / sub-path hosting (optional) ---
# Mount the app under a URL sub-path (e.g. "/ministry") when behind a path-
# based reverse proxy such as a Cloudflare Tunnel route. Leave empty (default)
# to serve at the root. The frontend bundle is prefix-agnostic — the backend
# injects a <base href> tag into index.html at request time so the same image
# works at any prefix without rebuilding.
# URL_PREFIX=

# --- SQLite on network filesystems (optional) ---
# Override the SQLite VFS for the database connection. Set to "unix-dotfile"
# when DATABASE_PATH lives on SMB/CIFS (e.g. Azure Files) so SQLite uses
# on-disk lock files instead of POSIX fcntl byte-range locks, which SMB
# does not honour reliably. Leave unset on local disks and GCS FUSE.
# SQLITE_VFS=
