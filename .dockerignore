# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/

# Node
node_modules/
npm-debug.log*

# Database (will be in mounted volume)
*.db
*.sqlite
*.sqlite3

# Git
.git/
.gitignore

# IDE
.vscode/
.idea/

# Documentation
README.md

# Environment files (defense-in-depth — none should exist in the
# build context anyway, but make sure .env, .env.local, .env.production,
# .env.staging, etc. are never accidentally COPYed into the image)
.env*

# OS
.DS_Store
Thumbs.db

# Tests (never ship to container)
tests/
frontend/src/__tests__/

# Frontend build artifacts (built inside Docker)
frontend/dist/
frontend/node_modules/
